<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ڕاپۆرتی فرۆشتن | ڕیکار ستۆر</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@700;800;900&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#121019;
    --surface:#1c1828;
    --surface-alt:#241f35;
    --line: rgba(255,255,255,0.09);
    --text:#f6f3ff;
    --muted:#9c95b8;
    --coral:#ff4d6d;
    --gold:#ffc93c;
    --flame-grad: linear-gradient(90deg, var(--coral), var(--gold));
    --radius: 18px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Noto Naskh Arabic', serif;
    line-height:1.8;
    min-height:100vh;
  }
  h1,h2,h3{ font-family:'Noto Kufi Arabic', sans-serif; font-weight:800; }
  .num{ font-family:'IBM Plex Sans Arabic', sans-serif; font-variant-numeric: tabular-nums; }
  :focus-visible{ outline:2px solid var(--gold); outline-offset:3px; }
  .wrap{ max-width:760px; margin:0 auto; padding:32px 20px 60px; }

  /* ---------- Login screen ---------- */
  #login-screen{
    min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;
  }
  .login-card{
    background:var(--surface); border:1px solid var(--line); border-radius:20px;
    width:100%; max-width:380px; padding:32px;
  }
  .login-card .brand{ font-size:22px; text-align:center; margin-bottom:6px; }
  .login-card .brand span{ color:var(--coral); }
  .login-card .sub{ text-align:center; color:var(--muted); font-size:13px; margin-bottom:24px; }

  .field{ margin-bottom:14px; }
  .field label{ display:block; font-size:13px; color:var(--muted); margin-bottom:6px; }
  .field input, .field select{
    width:100%; background:var(--surface-alt); border:1px solid var(--line); color:var(--text);
    padding:12px 14px; border-radius:10px; font-family:inherit; font-size:15px;
  }
  .field input:focus, .field select:focus{ border-color:var(--gold); }
  .row-2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .btn-block{ width:100%; text-align:center; padding:14px; border-radius:10px; font-weight:700; cursor:pointer; border:none; font-size:15px; }
  .btn-block.primary{ background:var(--flame-grad); color:#1a1220; }
  .btn-block.primary:hover{ opacity:0.92; }
  .error-msg{ color:var(--coral); font-size:13px; margin-top:10px; display:none; text-align:center; }
  .error-msg.show{ display:block; }

  /* ---------- Dashboard ---------- */
  .dash-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
  .dash-head h1{ font-size:22px; }
  .logout-btn{ background:none; border:1px solid var(--line); color:var(--muted); border-radius:10px; padding:9px 16px; font-size:13px; cursor:pointer; }
  .logout-btn:hover{ border-color:var(--coral); color:var(--coral); }

  .admin-summary{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:20px; }
  .stat-card{ background:var(--surface-alt); border:1px solid var(--line); border-radius:14px; padding:16px; }
  .stat-card .stat-label{ font-size:12px; color:var(--muted); margin-bottom:6px; }
  .stat-card .stat-value{ font-family:'Noto Kufi Arabic', sans-serif; font-size:24px; color:var(--gold); }

  .admin-form{ background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:20px; margin-bottom:20px; }
  .admin-form h4{ font-size:15px; margin-bottom:14px; color:var(--text); font-family:'Noto Kufi Arabic', sans-serif; }

  .date-switch{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .date-switch label{ color:var(--muted); font-size:13px; white-space:nowrap; }
  .date-switch input{ flex:1; background:var(--surface-alt); border:1px solid var(--line); color:var(--text); padding:10px 12px; border-radius:10px; font-family:inherit; }

  .report-box{ background:var(--surface); border:1px solid var(--line); border-radius:16px; padding:18px; }
  table.sales-table{ width:100%; border-collapse:collapse; font-size:13px; }
  table.sales-table th{ text-align:right; color:var(--muted); font-weight:600; padding:8px 6px; border-bottom:1px solid var(--line); font-size:12px; }
  table.sales-table td{ padding:10px 6px; border-bottom:1px solid var(--line); }
  table.sales-table tr:last-child td{ border-bottom:none; }
  .del-row{ background:none; border:none; color:var(--coral); cursor:pointer; font-size:16px; }
  .empty-note{ color:var(--muted); font-size:13px; text-align:center; padding:24px 0; }
</style>
</head>
<body>

<!-- ===== Login screen ===== -->
<div id="login-screen">
  <div class="login-card">
    <div class="brand">ڕیکار<span>ستۆر</span></div>
    <p class="sub">تووڵامرازی تایبەت بە ڕاپۆرتی فرۆشتن — تەنها بۆ خۆت</p>
    <div class="field">
      <label>وشەی نهێنی</label>
      <input type="password" id="admin-password" placeholder="••••••••" autofocus>
    </div>
    <button class="btn-block primary" id="login-submit">چوونەژوورەوە</button>
    <p class="error-msg" id="login-error">وشەی نهێنی هەڵەیە.</p>
  </div>
</div>

<!-- ===== Dashboard screen ===== -->
<div id="dashboard-screen" style="display:none;">
  <div class="wrap">
    <div class="dash-head">
      <h1>ڕاپۆرتی فرۆشتنی ڕۆژانە</h1>
      <button class="logout-btn" id="admin-logout">چوونەدەرەوە</button>
    </div>

    <div class="admin-summary">
      <div class="stat-card">
        <div class="stat-label">کۆی دانەی فرۆشراو (ڕۆژی هەڵبژێردراو)</div>
        <div class="stat-value num" id="stat-count">٠</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">کۆی داهات (ڕۆژی هەڵبژێردراو)</div>
        <div class="stat-value num" id="stat-total">٠ د.ع.</div>
      </div>
    </div>

    <div class="admin-form">
      <h4>زیادکردنی فرۆشتنێکی نوێ</h4>
      <div class="field">
        <label>کاڵا</label>
        <select id="sale-product"></select>
      </div>
      <div class="row-2">
        <div class="field">
          <label>ژمارە (دانە)</label>
          <input type="number" id="sale-qty" value="1" min="1">
        </div>
        <div class="field">
          <label>نرخی یەکە (د.ع.)</label>
          <input type="number" id="sale-price" step="500">
        </div>
      </div>
      <div class="row-2">
        <div class="field">
          <label>جۆری داشکاندن</label>
          <select id="sale-discount-type">
            <option value="none">هیچ داشکاندنێک نییە</option>
            <option value="percent">ڕێژەیی (%)</option>
            <option value="amount">بڕی دیاریکراو (د.ع.)</option>
          </select>
        </div>
        <div class="field">
          <label>بڕی داشکاندن</label>
          <input type="number" id="sale-discount-value" value="0" min="0">
        </div>
      </div>
      <div class="field">
        <label>تێبینی (ئارەزوومەندانە)</label>
        <input type="text" id="sale-note" placeholder="بۆ نموونە: ناوی کڕیار">
      </div>
      <button class="btn-block primary" id="sale-submit">زیادکردنی فرۆشتن</button>
    </div>

    <div class="date-switch">
      <label>بینینی ڕاپۆرتی ڕۆژی:</label>
      <input type="date" id="report-date">
    </div>

    <div class="report-box">
      <div style="overflow-x:auto;">
        <table class="sales-table" id="sales-table">
          <thead>
            <tr>
              <th>کات</th><th>کاڵا</th><th>دانە</th><th>نرخی یەکە</th><th>داشکاندن</th><th>کۆی گشتی</th><th></th>
            </tr>
          </thead>
          <tbody id="sales-tbody"></tbody>
        </table>
        <p class="empty-note" id="sales-empty" style="display:none;">هیچ فرۆشتنێک بۆ ئەم ڕۆژە تۆمار نەکراوە.</p>
      </div>
    </div>
  </div>
</div>

<!-- Firebase SDKs -->
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>

<script>
  // Firebase configuration
  const firebaseConfig = {
    apiKey: "AIzaSyACCL4vfHLVG8Ky_RobFmvrCvW4uigtzJk",
    authDomain: "rekar-store.firebaseapp.com",
    projectId: "rekar-store",
    storageBucket: "rekar-store.firebasestorage.app",
    messagingSenderId: "688008496041",
    appId: "1:688008496041:web:0423656ffab7957f507ab8"
  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();

  const products = [
    { name:"بازنی ئەسپرەی بۆن", price:"١٥,٠٠٠ د.ع." },
    { name:"ڕیشتەی ڕووناکی LED", price:"١٥,٠٠٠ د.ع." },
    { name:"مینی پرۆژێکتەری گەشتیار", price:"٤٥,٠٠٠ د.ع." },
    { name:"پایە و ڕۆشنایی مۆبایل", price:"١٢,٠٠٠ د.ع." },
    { name:"هێدفۆنی بێ وایەری زیرەک", price:"٣٥,٠٠٠ د.ع." },
    { name:"کاتژمێری زیرەک", price:"٦٠,٠٠٠ د.ع." },
    { name:"بلێندەری گەشتیار", price:"٢٥,٠٠٠ د.ع." },
    { name:"لیدی موگناتیس", price:"١٥,٠٠٠ د.ع." }
  ];

  const ADMIN_PASSWORD = "rekar2026";

  const $ = (id) => document.getElementById(id);
  const toArabicNum = (n) => Number(n).toLocaleString('en-US');

  const loginScreen = $('login-screen');
  const dashboardScreen = $('dashboard-screen');

  $('login-submit').addEventListener('click', () => {
    const val = $('admin-password').value;
    if (val === ADMIN_PASSWORD) {
      $('login-error').classList.remove('show');$('admin-password').value = '';
      sessionStorage.setItem('rekarAdminAuthed', '1');
      loginScreen.style.display = 'none';
      dashboardScreen.style.display = 'block';
      openAdmin();
    } else {
      $('login-error').classList.add('show');
    }
  });
  $('admin-password').addEventListener('keydown', (e) => { if (e.key === 'Enter')$('login-submit').click(); });

  $('admin-logout').addEventListener('click', () => {
    sessionStorage.removeItem('rekarAdminAuthed');
    location.reload();
  });

  function todayStr() {
    const d = new Date();
    return d.toISOString().slice(0, 10);
  }

  function priceToNumber(str) {
    const eastern = "٠١٢٣٤٥٦٧٨٩";
    const converted = String(str).replace(/[٠-٩]/g, d => eastern.indexOf(d));
    const match = converted.match(/[\d,]+/);
    return match ? parseInt(match[0].replace(/,/g, ''), 10) : 0;
  }

  function populateProductSelect() {
    const sel = $('sale-product');
    sel.innerHTML = products.map((p, i) => `<option value="${i}">${p.name}</option>`).join('') + `<option value="custom">کاڵای دیکە (بەدەستی بنووسە)</option>`;
    sel.addEventListener('change', () => {
      if (sel.value !== 'custom') {
        $('sale-price').value = priceToNumber(products[sel.value].price);
      }
    });
    if (products.length) $('sale-price').value = priceToNumber(products[0].price);
  }

  function openAdmin() {
    if (!$('report-date').value)$('report-date').value = todayStr();
    listenToReport();
  }

  let unsubscribe = null;

  function listenToReport() {
    const date = $('report-date').value || todayStr();
    
    if (unsubscribe) unsubscribe();

    unsubscribe = db.collection("sales")
      .where("date", "==", date)
      .onSnapshot((snapshot) => {
        const all = [];
        snapshot.forEach((doc) => {
          all.push({ id: doc.id, ...doc.data() });
        });
        
        all.sort((a, b) => a.time.localeCompare(b.time));
        renderReportUI(all);
      });
  }

  function renderReportUI(all) {
    const tbody = $('sales-tbody');
    const emptyNote = $('sales-empty');
    tbody.innerHTML = '';

    if (!all.length) {
      emptyNote.style.display = 'block';
    } else {
      emptyNote.style.display = 'none';
      all.forEach(s => {
        const discountLabel = s.discountType === 'none' ? '—'
          : s.discountType === 'percent' ? `${s.discountValue}%`
          : `${toArabicNum(s.discountValue)} د.ع.`;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${s.time}</td>
          <td>${s.product}</td>
          <td class="num">${s.qty}</td>
          <td class="num">${toArabicNum(s.unitPrice)}</td>
          <td class="num">${discountLabel}</td>
          <td class="num">${toArabicNum(s.total)}</td>
          <td><button class="del-row" data-id="${s.id}" title="سڕینەوە">✕</button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    const totalCount = all.reduce((sum, s) => sum + Number(s.qty), 0);
    const totalRevenue = all.reduce((sum, s) => sum + Number(s.total), 0);
    $('stat-count').textContent = toArabicNum(totalCount);$('stat-total').textContent = toArabicNum(totalRevenue) + ' د.ع.';

    tbody.querySelectorAll('.del-row').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        db.collection("sales").doc(id).delete();
      });
    });
  }

  $('report-date').addEventListener('change', listenToReport);

  $('sale-submit').addEventListener('click', () => {
    const sel = $('sale-product');
    const productName = sel.value === 'custom'
      ? (prompt('ناوی کاڵاکە بنووسە:') || '').trim()
      : products[sel.value].name;
    if (!productName) return;

    const qty = Math.max(1, parseInt($('sale-qty').value, 10) || 1);
    const unitPrice = Math.max(0, parseFloat($('sale-price').value) || 0);
    const discountType = $('sale-discount-type').value;
    const discountValue = Math.max(0, parseFloat($('sale-discount-value').value) || 0);

    let subtotal = qty * unitPrice;
    let total = subtotal;
    if (discountType === 'percent') {
      total = subtotal - (subtotal * discountValue / 100);
    } else if (discountType === 'amount') {
      total = subtotal - discountValue;
    }
    total = Math.max(0, Math.round(total));

    const now = new Date();
    const record = {
      date: $('report-date').value || todayStr(),
      time: now.toTimeString().slice(0, 5),
      product: productName,
      qty, unitPrice, discountType, discountValue, total,
      note: $('sale-note').value.trim(),
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    };

    db.collection("sales").add(record);

    $('sale-qty').value = 1;
    $('sale-discount-type').value = 'none';$('sale-discount-value').value = 0;
    $('sale-note').value = '';
  });

  populateProductSelect();
  if (sessionStorage.getItem('rekarAdminAuthed') === '1') {
    loginScreen.style.display = 'none';
    dashboardScreen.style.display = 'block';
    openAdmin();
  }
</script>
</body>
</html>
